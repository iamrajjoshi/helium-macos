@@ -19,6 +19,26 @@
 #include "testing/gtest/include/gtest/gtest.h"
 
 namespace chrome {
+
+#if BUILDFLAG(IS_MAC)
+TEST(HeliumArcPreviewIdentity, UsesSeparateDefaultDataAndCache) {
+  base::FilePath data_dir;
+  ASSERT_TRUE(GetDefaultUserDataDirectory(&data_dir));
+  EXPECT_EQ("io.github.iamrajjoshi.helium-arc-preview",
+            data_dir.BaseName().value());
+  base::FilePath app_data;
+  ASSERT_TRUE(base::PathService::Get(base::DIR_APP_DATA, &app_data));
+  EXPECT_EQ(app_data.Append("io.github.iamrajjoshi.helium-arc-preview"),
+            data_dir);
+  base::FilePath cache_dir;
+  GetUserCacheDirectory(data_dir.Append("Default"), &cache_dir);
+  base::FilePath cache_root;
+  ASSERT_TRUE(base::PathService::Get(base::DIR_CACHE, &cache_root));
+  EXPECT_EQ(cache_root.Append("io.github.iamrajjoshi.helium-arc-preview")
+                .Append("Default"),
+            cache_dir);
+}
+#endif
 
